{% extends 'base.html.twig' %}
{% block title %}Mes classes{% endblock %}
{% block body %}

    <div class="hero">
        <h1>👥 Mes classes</h1>
        <p>Gérez vos promotions et étudiants.</p>
    </div>

    {% if promotions|length > 0 %}
        <div class="dashboard-cards">
            {% for promotion in promotions %}
                <div class="card">
                    <h2>🎓 {{ promotion.name }}</h2>
                    <p>
                        <strong>{{ promotion.users|length }}</strong> étudiant(s)
                    </p>
                    <a href="{{ path('app_coordinator_promotion_show', {'id': promotion.id}) }}"
                       class="btn btn-primary">
                        Voir la classe
                    </a>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card" style="text-align:center; padding:2rem;">
            <p style="color:#64748b;">Aucune promotion assignée.</p>
        </div>
    {% endif %}

{% endblock %}