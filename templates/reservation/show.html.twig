{% extends 'base.html.twig' %}

{% block title %}Détail de la réservation{% endblock %}

{% block body %}

    <div class="page-header">
        <h1>📅 Détail de la réservation</h1>
        <a href="{{ path('app_reservation_index') }}" class="btn">← Retour à la liste</a>
    </div>

    <div class="card" style="max-width:600px; margin-bottom:1.5rem;">
        <p><strong>Salle :</strong> {{ reservation.room.name }}</p>
        <p><strong>Date de début :</strong> {{ reservation.startDatetime|date('d/m/Y H:i') }}</p>
        <p><strong>Date de fin :</strong> {{ reservation.endDatetime|date('d/m/Y H:i') }}</p>
        <p><strong>Promotion concernée :</strong> {{ reservation.bookedFor ? reservation.bookedFor.name : '—' }}</p>
        <p><strong>Réservé par :</strong> {{ reservation.owner.firstName }} {{ reservation.owner.lastName }}</p>
        <p><strong>Créée le :</strong> {{ reservation.createdAt|date('d/m/Y H:i') }}</p>
        <p>
            <strong>Statut :</strong>
            {% if reservation.cancelledAt %}
                <span style="color:#dc2626;">❌ Annulée le {{ reservation.cancelledAt|date('d/m/Y H:i') }}</span>
            {% elseif reservation.endDatetime < date() %}
                <span style="color:#64748b;">⏱ Terminée</span>
            {% else %}
                <span style="color:#16a34a;">✅ Active</span>
            {% endif %}
        </p>
    </div>

    {# Bouton d'annulation uniquement si la réservation est encore active #}
    {% if not reservation.cancelledAt and reservation.endDatetime > date() %}
        <form method="post"
              action="{{ path('app_reservation_cancel', {'id': reservation.id}) }}"
              data-confirm="Êtes-vous sûr de vouloir annuler cette réservation ?">
            <input type="hidden" name="_token" value="{{ csrf_token('cancel' ~ reservation.id) }}">
            <button type="submit" class="btn btn-danger">❌ Annuler la réservation</button>
        </form>
    {% endif %}

{% endblock %}